# AWS Account Details
AWS_ACCOUNT_ID="123456789012"
AWS_REGION="us-east-1"
# Leave blank to use an AWS profile, SSO session or IAM role.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# VPC/Network
VPC_ID="vpc-xxxxxxxx"
SUBNET_1_ID="subnet-11111111"
SUBNET_2_ID="subnet-22222222"
ALB_SG_ID="sg-xxxxxxxx"
ECS_TASKS_SG_ID="sg-xxxxxxxx"

# Load Balancer
ALB_NAME="my-static-alb"
ALB_ARN="arn:aws:elasticloadbalancing:us-east-1:123456789012:loadbalancer/app/my-static-alb/xxxxxxxx"

# IAM Roles
ECS_TASK_EXECUTION_ROLE_ARN="arn:aws:iam::123456789012:role/ecsTaskExecutionRole"
ECS_TASK_ROLE_ARN="arn:aws:iam::123456789012:role/ecsTaskRole"

# ECS
ECS_CLUSTER_NAME="my-ecs-cluster"

# Pre-created shared domain pointing to the ALB; certificate covers this hostname.
BASE_DOMAIN="example.com"
ACM_CERTIFICATE_ARN="arn:aws:acm:us-east-1:123456789012:certificate/xxxxx-xxxxx"

# Database
MSSQL_SA_PASSWORD=""
APP_KEY=""
