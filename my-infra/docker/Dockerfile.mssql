FROM --platform=linux/amd64 mcr.microsoft.com/mssql/server:2017-latest

# Install SSH server and additional useful tools
USER root
RUN apt-get update && apt-get install -y \
    openssh-server \
    curl \
    iputils-ping \
    net-tools \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Setup SSH
RUN mkdir /root/.ssh
COPY .ssh/authorized_keys /root/.ssh/authorized_keys
RUN chmod 700 /root/.ssh && chmod 600 /root/.ssh/authorized_keys

# Create directories and set permissions
RUN mkdir -p /var/opt/mssql/log && \
    mkdir -p /var/opt/mssql/data && \
    chmod -R 755 /var/opt/mssql

# Configure SSH
RUN sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin yes/' /etc/ssh/sshd_config

# Expose ports for SQL Server and SSH
EXPOSE 1433 22

# Copy schema and initialization script
COPY schema.sql /schema.sql
COPY init-db.sh /init-db.sh
RUN chmod +x /init-db.sh

# Set environment variables for SQL Server
ENV ACCEPT_EULA=Y
ENV MSSQL_PID=Express
ENV SA_PASSWORD="REDACTED"
ENV MSSQL_TCP_PORT=1433
ENV MSSQL_MEMORY_LIMIT_MB=4096
ENV MSSQL_BACKUP_DIR=/var/opt/mssql/backup
ENV MSSQL_DATA_DIR=/var/opt/mssql/data
ENV MSSQL_LOG_DIR=/var/opt/mssql/log

# Create backup directory
RUN mkdir -p $MSSQL_BACKUP_DIR && \
    chmod -R 755 $MSSQL_BACKUP_DIR

CMD ["/bin/bash", "-c", "service ssh start && /init-db.sh"]